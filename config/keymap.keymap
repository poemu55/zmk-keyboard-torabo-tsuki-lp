#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <200>; };

/ {
    macros {
        num_layer: num_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &mo 2>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 2>;
        };

        zoom_ctrl: zoom_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 10 &kp LCTRL>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 10 &kp LCTRL>;
        };

        mb5_gesture: mb5_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7 &mouse_gesture &mkp MB5>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 7 &mouse_gesture &mkp MB5>;
        };

        mb4_gesture: mb4_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 8 &mouse_gesture &mkp MB4>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 8 &mouse_gesture &mkp MB4>;
        };

        u_gesture_hold: u_gesture_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 11 &mouse_gesture>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 11 &mouse_gesture>;
        };

        o_
