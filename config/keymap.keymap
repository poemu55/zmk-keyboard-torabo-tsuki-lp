#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <3>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none     &none                 &none                                          &none        &none  &none      &none           &none                 &none
&none  &mt ESCAPE Q      &kp W     &kp E     &kp R                 &kp T                                          &kp Y        &kp U  &kp I      &kp O           &kp P                 &none
&none  &mt CAPSLOCK A    &kp S     &kp D     &kp F                 &kp G            &none        &none            &kp H        &kp J  &kp K      &kp L           &lt 6 MINUS           &none
&none  &mt LEFT_SHIFT Z  &kp X     &kp C     &kp V                 &kp B            &kp TAB      &kp DEL          &kp N        &kp M  &kp COMMA  &kp DOT         &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL         &kp LGUI  &kp LALT  &lt 3 LG(LANGUAGE_2)  &lt 2 LG(LANG1)  &lt 1 SPACE  &lt 4 BACKSPACE  &lt 5 ENTER  &none  &none      &kp APOSTROPHE  &kp SEMICOLON         &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans              &trans            &trans              &trans           &trans    &trans
&trans  &none   &none   &none   &none   &none                       &kp PAGE_UP         &none             &kp UP_ARROW        &none            &kp HOME  &trans
&trans  &none   &none   &none   &none   &none   &trans  &trans      &kp PAGE_DOWN       &kp LEFT_ARROW    &kp DOWN_ARROW      &kp RIGHT_ARROW  &kp END   &trans
&trans  &none   &none   &none   &none   &none   &trans  &trans      &kp RC(LEFT_ARROW)  &kp RC(UP_ARROW)  &kp RC(DOWN_ARROW)  &kp RC(RIGHT)    &none     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &none               &none             &trans              &trans           &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans            &trans        &trans        &trans        &trans                       &trans  &trans  &trans  &trans  &trans   &trans
&trans  &kp PLUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL                    &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &kp MINUS         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA   &trans   &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp LG(ASTERISK)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp SQT  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
&trans  &kp SLASH         &kp NUMBER_0  &trans        &trans        &trans      &trans   &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans         &trans         &trans       &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(N1)     &none          &none        &none   &none                   &none   &none   &none   &none   &none   &trans
&trans  &kp LC(PLUS)   &kp LC(MINUS)  &none        &none   &none   &trans  &trans  &none   &none   &none   &none   &none   &trans
&trans  &kp LC(LA(V))  &kp LG(LS(S))  &kp LA(TAB)  &none   &none   &trans  &trans  &none   &none   &none   &none   &none   &trans
&trans  &trans         &trans         &trans       &none   &none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &bt BT_CLR    &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans                &trans                 &trans         &trans             &trans                          &trans  &trans                &trans                 &trans                &trans  &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp DOUBLE_QUOTES  &kp PLUS                        &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans                &trans  &trans
&trans  &kp PERCENT           &kp CARET              &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH  &trans  &trans
&trans  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH       &kp DOLLAR         &none           &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans                &trans  &trans
&trans  &kp SEMICOLON         &kp SQT                &trans         &trans             &trans          &trans  &trans  &trans  &trans                &trans                 &trans                &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans             &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &kp K_SCROLL_UP    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp K_SCROLL_DOWN  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans
            >;
        };
    };
};
