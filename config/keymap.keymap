#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    &trackball_listener {
        scroll_layer {
            layers = <3>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none         &none                 &none                                          &none        &none  &none      &none           &none                 &none
&none  &mt ESCAPE Q      &kp W     &kp E         &kp R                 &kp T                                          &kp Y        &kp U  &kp I      &kp O           &lt 3 P              &none
&none  &mt CAPSLOCK A    &kp S     &kp D         &kp F                 &kp G            &none        &none            &kp H        &kp J  &kp K      &kp L           &lt 0 MINUS           &none
&none  &mt LEFT_SHIFT Z  &kp X     &kp C         &kp V                 &kp B            &kp TAB      &kp DEL          &kp N        &kp M  &kp COMMA  &kp DOT         &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL         &kp LGUI  &kp LEFT_ALT  &lt 6 LG(LANGUAGE_2)  &lt 2 LG(LANG1)  &lt 1 SPACE  &lt 4 BACKSPACE  &lt 5 ENTER  &none  &none      &kp APOSTROPHE  &kp SEMICOLON         &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans            &trans              &trans              &trans              &trans                                    &trans              &trans            &trans              &trans           &trans    &trans
&trans  &kp LC(NUMBER_1)  &none               &kp LG(UP_ARROW)    &none               &kp LC(LA(V))                             &kp PAGE_UP         &none             &kp UP_ARROW        &none            &kp HOME  &trans
&trans  &kp LC(PLUS)      &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(DOWN_ARROW)  &kp LA(TAB)    &trans         &trans      &kp PAGE_DOWN       &kp LEFT_ARROW    &kp DOWN_ARROW      &kp RIGHT_ARROW  &kp END   &trans
&trans  &kp LC(MINUS)     &none               &none               &none               &none          &kp LG(LS(S))  &trans      &kp RC(LEFT_ARROW)  &kp RC(UP_ARROW)  &kp RC(DOWN_ARROW)  &kp RC(RIGHT)    &none     &trans
&trans  &trans            &trans              &trans              &trans              &trans         &trans         &kp DELETE  &none               &none             &trans              &trans           &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &none   &kp F7  &kp F8  &kp F9  &kp F12                   &kp COMMA     &kp NUMBER_7  &kp NUMBER_8  &kp N9        &kp PLUS      &trans
&trans  &none   &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans   &kp PERIOD    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS     &trans
&trans  &none   &kp F1  &kp F2  &kp F3  &kp F10  &none   &kp SQT  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &trans
&trans  &none   &none   &trans  &trans  &trans   &trans  &trans   &trans        &trans        &trans        &trans        &kp SLASH     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &none   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &none         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans                &trans                 &trans         &trans             &trans                          &trans  &trans                &trans                 &trans                &trans  &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp DOUBLE_QUOTES  &kp PLUS                        &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans                &trans  &trans
&trans  &kp PERCENT           &kp CARET              &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH  &trans  &trans
&trans  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH       &kp DOLLAR         &none           &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans                &trans  &trans
&trans  &kp SEMICOLON         &kp SQT                &trans         &trans             &trans          &trans  &trans  &trans  &trans                &trans                 &trans                &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans          &msc SCRL_UP    &trans           &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
