#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none     &none                 &none                                      &none        &none  &none      &none           &none                 &none
&none  &mt ESCAPE Q      &kp W     &kp E     &kp R                 &kp T                                      &kp Y        &kp U  &kp I      &kp O           &kp P                 &none
&none  &mt CAPSLOCK A    &kp S     &kp D     &kp F                 &kp G            &none      &none          &kp H        &kp J  &kp K      &kp L           &kp MINUS             &none
&none  &mt LEFT_SHIFT Z  &kp X     &kp C     &kp V                 &kp B            &kp TAB    &kp DEL        &kp N        &kp M  &kp COMMA  &kp DOT         &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL         &kp LGUI  &kp LALT  &lt 2 LG(LANGUAGE_2)  &lt 1 LG(LANG1)  &kp SPACE  &kp BACKSPACE  &lt 3 ENTER  &none  &none      &kp APOSTROPHE  &kp SEMICOLON         &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans            &trans        &trans        &trans        &trans                       &trans  &trans  &trans  &trans  &trans   &trans
&trans  &kp PLUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL                    &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &kp MINUS         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA   &trans   &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp LG(ASTERISK)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp SQT  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
&trans  &kp SLASH         &kp NUMBER_0  &trans        &trans        &trans      &trans   &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans         &trans          &trans          &trans           &trans    &trans
&trans  &none   &none   &none   &none   &none                   &kp PAGE_UP    &none           &kp UP_ARROW    &none            &kp HOME  &trans
&trans  &none   &none   &none   &none   &none   &trans  &trans  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END   &trans
&trans  &none   &none   &none   &none   &none   &trans  &trans  &none          &none           &none           &none            &none     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none          &none           &trans          &trans           &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };
    };
};
