#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <200>; };

/ {
    macros {
        num_layer: num_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &mo 2>, <&macro_pause_for_release>, <&macro_release &mo 2>;
        };

        zoom_ctrl: zoom_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 10 &kp LCTRL>, <&macro_pause_for_release>, <&macro_release &mo 10 &kp LCTRL>;
        };

        /* MB5を押している間、MB5入力とジェスチャーレイヤー7を有効化 */
        mb5_gesture: mb5_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 7 &mouse_gesture &mkp MB5>, <&macro_pause_for_release>, <&macro_release &mo 7 &mouse_gesture &mkp MB5>;
        };

        /* MB4を押している間、MB4入力とジェスチャーレイヤー8を有効化 */
        mb4_gesture: mb4_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 8 &mouse_gesture &mkp MB4>, <&macro_pause_for_release>, <&macro_release &mo 8 &mouse_gesture &mkp MB4>;
        };

        /* Uを押している間、ジェスチャーレイヤー11を有効化 */
        u_gesture: u_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 11 &mouse_gesture>, <&macro_pause_for_release>, <&macro_release &mo 11 &mouse_gesture>;
        };

        /* Oを押している間、ジェスチャーレイヤー12を有効化 */
        o_gesture: o_gesture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 12 &mouse_gesture>, <&macro_pause_for_release>, <&macro_release &mo 12 &mouse_gesture>;
        };
    };

    behaviors {
        z_mt: z_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        num_lt: num_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&num_layer>, <&kp>;
        };

        zoom_ctrl_lt: zoom_ctrl_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-while-undecided-linger;
            bindings = <&zoom_ctrl>, <&kp>;
        };

        gesture_lt: gesture_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-while-undecided-linger;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <100>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none               &none     &none         &none               &none                                             &none        &none       &none      &none       &none                 &none
&none  &kp Q               &kp W     &kp E         &kp R               &kp T                                             &kp Y        &u_gesture  &kp I      &o_gesture  &lt 3 P               &none
&none  &kp A               &kp S     &kp D         &kp F               &kp G               &none        &none            &kp H        &lt 7 J     &lt 8 K    &lt 9 L     &lt 0 MINUS           &none
&none  &z_mt LEFT_SHIFT Z  &kp X     &kp C         &kp V               &kp B               &kp TAB      &kp ESCAPE       &kp N        &kp M       &kp COMMA  &kp DOT     &mt RIGHT_SHIFT FSLH  &none
&none  &zoom_ctrl_lt 0 LCTRL  &kp LGUI  &kp LEFT_ALT  &lt 6 LS(CAPSLOCK)  &num_lt 0 LC(CAPSLOCK)  &lt 1 SPACE  &lt 4 BACKSPACE  &lt 5 ENTER  &none    &none      &kp APOSTROPHE  &kp SEMICOLON         &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans            &trans              &trans              &trans         &trans                                    &trans              &trans            &trans              &trans           &trans    &trans
&trans  &kp LC(NUMBER_1)  &none               &kp LG(UP_ARROW)    &none          &kp LC(LA(V))                             &kp PAGE_UP         &none             &kp UP_ARROW        &none            &kp HOME  &trans
&trans  &kp LC(PLUS)      &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT)  &kp LA(TAB)    &trans         &trans      &kp PAGE_DOWN       &kp LEFT_ARROW    &kp DOWN_ARROW      &kp RIGHT_ARROW  &kp END   &trans
&trans  &kp LC(MINUS)     &none               &none               &kp LC(LA(T))  &kp LC(LA(P))  &kp LG(LS(S))  &trans      &kp RC(LEFT_ARROW)  &kp RC(UP_ARROW)  &kp RC(DOWN_ARROW)  &kp RC(RIGHT)    &none     &trans
&trans  &trans            &trans              &trans              &trans         &trans         &trans         &kp DELETE  &none               &none             &trans              &trans           &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                             &trans        &trans        &trans        &trans        &trans        &trans
&trans  &none   &kp F7  &kp F8  &kp F9  &kp F12                            &kp COMMA     &kp KP_N7  &kp KP_N8  &kp KP_N9        &kp KP_PLUS      &trans
&trans  &none   &kp F4  &kp F5  &kp F6  &kp F11  &trans        &trans      &kp KP_DOT    &kp KP_N4  &kp KP_N5        &kp KP_N6  &kp KP_MINUS     &trans
&trans  &none   &kp F1  &kp F2  &kp F3  &kp F10  &kp CAPSLOCK  &kp SQT     &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY  &trans
&trans  &none   &none   &trans  &trans  &trans   &trans        &kp DELETE  &trans        &trans        &trans        &kp EQUAL  &kp KP_DIVIDE     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &none         &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans                &trans                 &trans         &trans             &trans                          &trans  &trans                &trans                 &trans                &trans  &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &kp DOUBLE_QUOTES  &kp KP_PLUS                        &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans                &trans  &trans
&trans  &kp PERCENT           &kp CARET              &kp AMPERSAND  &kp KP_MULTIPLY       &kp UNDERSCORE  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH  &trans  &trans
&trans  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH       &kp DOLLAR         &none           &trans  &trans  &trans  &kp LEFT_BRACE
